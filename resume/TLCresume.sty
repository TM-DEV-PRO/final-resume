\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{TLCresume}[2025/12/12 resume package]
% Author: Timmy Chan

% ===== FONT SETTINGS =====
\RequirePackage[T1]{fontenc}
\RequirePackage[default,semibold]{sourcesanspro}
\RequirePackage{anyfontsize}
\RequirePackage{csquotes}
\RequirePackage{fancyhdr}

% Set smaller base font size for compactness
\renewcommand\normalsize{\fontsize{10}{12}\selectfont}

% ===== MARGINS & SPACING =====
\RequirePackage[paper=letterpaper, left=0.05in, right=0.05in, top=0.3in, bottom=0.4in]{geometry}
\raggedright
\raggedbottom

% ===== COLOR (Defined in main .tex for flexibility) =====
% (All color definitions are commented out here, and are expected to be set in the main .tex file.)
% If uncommented, these would have no effect if the same color names are redefined in the main .tex file after loading this package.


% These color definitions are safe to keep commented for reference; if uncommented, they will be overridden by the main .tex file's color definitions.

% ===== LINKS =====
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,urlcolor=highlight}

% ===== BULLET POINTS =====
\RequirePackage[inline]{enumitem}
\setlength{\tabcolsep}{0in}
\setlist[itemize]{align=parleft,left=0pt..0.5em}
\newenvironment{zitemize}{
  \begin{itemize}\itemsep 0.8pt \parskip 0.3pt \parsep 0pt
}{
  \end{itemize}\vspace{-0.5em}
}

% ===== SECTION FORMATTING =====
\RequirePackage[nostruts]{titlesec}
% Section formatting is controlled in main .tex for flexibility

% ===== UNUSED MACROS (commented out, not used in your content) =====
% \newcommand{\skills}[1]{{\bfseries #1}}
% \newcommand{\subtext}[1]{\textit{#1}\par\vspace{-1em}}

% ===== NO PAGE NUMBER =====
\pagenumbering{gobble}

% ===== SUBFILES IMPORTING =====
\RequirePackage{standalone}

% ===== FOR TEMPLATE FILL
\RequirePackage[english]{babel}
\RequirePackage{blindtext}